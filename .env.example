# 9Router on Render — environment notes
# Full upstream contract: see comments below (mirrors upstream .env.example).
# Blueprint defaults live in render.yaml. Prefer Dashboard edits for secrets after deploy.

# Required at first Apply (Blueprint sync: false)
INITIAL_PASSWORD=change-me-to-a-strong-password

# Set after the service is Live (both should match your public HTTPS origin)
BASE_URL=https://YOUR-SERVICE.onrender.com
NEXT_PUBLIC_BASE_URL=https://YOUR-SERVICE.onrender.com

# Wired by render.yaml
# PORT=20128
# HOSTNAME=0.0.0.0
# NODE_ENV=production
# DATA_DIR=/app/data
# REQUIRE_API_KEY=true
# AUTH_COOKIE_SECURE=true
# CLOUD_URL=https://9router.com
# NEXT_PUBLIC_CLOUD_URL=https://9router.com
# ENABLE_REQUEST_LOGS=false

# Auto-generated by Render on first deploy (do not commit real values)
# JWT_SECRET=
# API_KEY_SECRET=
# MACHINE_ID_SALT=

# Optional outbound proxy for upstream provider calls
# HTTP_PROXY=
# HTTPS_PROXY=
# ALL_PROXY=
# NO_PROXY=localhost,127.0.0.1

# Optional SearXNG endpoint for the built-in web-search provider
# SEARXNG_URL=http://searxng:8080/search
